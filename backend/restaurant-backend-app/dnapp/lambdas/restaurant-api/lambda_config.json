{
  "version": "1.0",
  "name": "restaurant-api",
  "func_name": "RestaurantLambdaFunction::RestaurantLambdaFunction.Function::FunctionHandlerAsync",
  "resource_type": "lambda",
  "iam_role_name": "restaurant-api-role",
  "runtime": "dotnet8",
  "memory": 2048,
  "timeout": 30,
  "lambda_path": "lambdas\\restaurant-api",
  "dependencies": [
    { "resource_name": "Locations",      "resource_type": "dynamodb_table" },
    { "resource_name": "Reservations",   "resource_type": "dynamodb_table" },
    { "resource_name": "TableDays",      "resource_type": "dynamodb_table" },
    { "resource_name": "WaiterSchedule", "resource_type": "dynamodb_table" },
    { "resource_name": "Tables",         "resource_type": "dynamodb_table" },
    { "resource_name": "Users",          "resource_type": "dynamodb_table" },
    { "resource_name": "Feedbacks",      "resource_type": "dynamodb_table" }
  ],
  "event_sources": [],
  "env_variables": {
    "COGNITO_USER_POOL_ID": "eu-west-2_t9vciMEPT",
    "COGNITO_CLIENT_ID": "71bjhomgknlcrp2qpqo2cv0tea",
    "COGNITO_REGION": "eu-west-2",
    "SEED_TOKEN": "dev-seed-123",
    "BACKFILL_USERS_ON_STARTUP": "true",
    "SQS_QUEUE_URL": "https://sqs.eu-west-2.amazonaws.com/864899830479/reservation-events-queue"
  },
  "publish_version": true,
  "alias": "${lambdas_alias_name}",
  "url_config": {},
  "ephemeral_storage": 512,
  "tags": {}
}