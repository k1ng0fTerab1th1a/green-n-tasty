  "TableDays": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "tableKey",
    "hash_key_type": "S",
    "sort_key_name": "date",
    "sort_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "ttl_attribute": "ttl",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [],
    "autoscaling": [],
    "tags": {}
  },
  "WaiterSchedule": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "tableKey",
    "hash_key_type": "S",
    "sort_key_name": "date",
    "sort_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [],
    "autoscaling": [],
    "tags": {}
  },
  "Tables": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "locationId",
    "hash_key_type": "S",
    "sort_key_name": "tableNumber",
    "sort_key_type": "N",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
