{
  "lambda-basic-execution": {
    "policy_content": {
      "Statement": [
        {
          "Action": [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents",
            "dynamodb:GetItem",
            "dynamodb:Query",
            "dynamodb:PutItem",
            "dynamodb:Batch*",
            "dynamodb:DeleteItem",
            "dynamodb:UpdateItem",
            "dynamodb:DescribeTable",
            "dynamodb:Scan",
            "dynamodb:ListTables",
            "ssm:PutParameter",
            "ssm:GetParameter",
            "kms:Decrypt",
            "cognito-idp:ListUserPools",
            "cognito-idp:ListUserPoolClients",
            "cognito-idp:SignUp",
            "cognito-idp:AdminCreateUser",
            "cognito-idp:AdminSetUserPassword",
            "cognito-idp:AdminConfirmSignUp",
            "cognito-idp:AdminUpdateUserAttributes",
            "cognito-idp:InitiateAuth",
            "cognito-idp:AdminDeleteUser",
            "cognito-idp:RevokeToken",
            "sqs:SendMessage",
            "sqs:ReceiveMessage",
            "sqs:DeleteMessage",
            "sqs:GetQueueAttributes",
            "ses:SendEmail",
            "ses:SendRawEmail",
            "s3:GetObject",
            "s3:PutObject"
          ],
          "Effect": "Allow",
          "Resource": "*"
        }
      ],
      "Version": "2012-10-17"
    },
    "resource_type": "iam_policy",
    "tags": {}
  },
  "restaurant-api-gateway": {
    "resource_type": "api_gateway",
    "deploy_stage": "dev",
    "dependencies": [
      {
        "resource_name": "restaurant-api",
        "resource_type": "lambda"
      }
    ],
    "resources": {
      "/{proxy+}": {
        "enable_cors": true,
        "ANY": {
          "authorization_type": "NONE",
          "integration_type": "lambda",
          "lambda_name": "restaurant-api",
          "enable_proxy": true,
          "default_error_pattern": true
        }
      }
    }
  },
  "reservation-events-queue": {
    "resource_type": "sqs_queue",
    "fifo_queue": false,
    "visibility_timeout": 30,
    "message_retention_period": 86400,
    "receive_message_wait_time_seconds": 0,
    "tags": {}
  },
  "reports-sender-schedule": {
    "resource_type": "eventbridge_rule",
    "rule_type": "schedule",
    "expression": "cron(0 23 ? * SUN *)",
    "region": "eu-west-2",
    "tags": {}
  },
  "restaurant-user-pool": {
    "resource_type": "cognito_idp",
    "password_policy": {
      "minimum_length": 8,
      "require_uppercase": true,
      "require_symbols": false,
      "require_lowercase": true,
      "require_numbers": true
    },
    "auto_verified_attributes": [
      "email"
    ],
    "username_attributes": [
      "email"
    ],
    "custom_attributes": [
      {
        "name": "role",
        "type": "String",
        "mutable": true,
        "required": false
      }
    ],
    "client": {
      "client_name": "restaurant-app-client",
      "generate_secret": false,
      "explicit_auth_flows": [
        "ALLOW_ADMIN_USER_PASSWORD_AUTH",
        "ALLOW_USER_SRP_AUTH",
        "ALLOW_REFRESH_TOKEN_AUTH",
        "ALLOW_USER_PASSWORD_AUTH"
      ]
    }
  },
  "Users": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "userId",
    "hash_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [
      {
        "name": "waiterFlag-index",
        "index_key_name": "waiterFlag",
        "index_key_type": "S"
      },
      {
        "name": "customer-firstName-index",
        "index_key_name": "role",
        "index_key_type": "S",
        "index_sort_key_name": "firstNameNormalized",
        "index_sort_key_type": "S"
      },
      {
        "name": "customer-lastName-index",
        "index_key_name": "role",
        "index_key_type": "S",
        "index_sort_key_name": "lastNameNormalized",
        "index_sort_key_type": "S"
      },
      {
        "name": "customer-email-index",
        "index_key_name": "role",
        "index_key_type": "S",
        "index_sort_key_name": "emailNormalized",
        "index_sort_key_type": "S"
      }
    ],
    "autoscaling": [],
    "tags": {}
  },
  "waiters-list": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "email",
    "hash_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [],
    "autoscaling": [],
    "tags": {}
  },
  "Locations": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "S",
    "read_capacity": 1,
    "write_capacity": 1,
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [],
    "autoscaling": [],
    "tags": {}
  },
  "Reservations": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "S",

    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [
      {
        "name": "customerId-start-index",
        "index_key_name": "customerId",
        "index_key_type": "S",
        "index_sort_key_name": "startDateTime",
        "index_sort_key_type": "S"
      },
      {
        "name": "tableKey-start-index",
        "index_key_name": "tableKey",
        "index_key_type": "S",
        "index_sort_key_name": "startDateTime",
        "index_sort_key_type": "S"
      },
      {
        "name": "waiterId-start-index",
        "index_key_name": "waiterId",
        "index_key_type": "S",
        "index_sort_key_name": "startDateTime",
        "index_sort_key_type": "S"
      }
    ],
    "autoscaling": [],
    "tags": {}
  },
  "Feedbacks": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [
      {
        "name": "locationId-type-index",
        "index_key_name": "locationId#type",
        "index_key_type": "S"
      },
      {
        "name": "LocationType-Date-Index",
        "index_key_name": "locationId#type",
        "index_key_type": "S",
        "index_sort_key_name": "date",
        "index_sort_key_type": "S"
      },
      {
        "name": "LocationType-Rate-Index",
        "index_key_name": "locationId#type",
        "index_key_type": "S",
        "index_sort_key_name": "rate",
        "index_sort_key_type": "N"
      },
      {
        "name": "reservationId-index",
        "index_key_name": "reservationId",
        "index_key_type": "S"
      }
    ],
    "autoscaling": [],
    "tags": {}
  },
  "Tables": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "locationId",
    "hash_key_type": "S",
    "sort_key_name": "tableNumber",
    "sort_key_type": "N",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [],
    "autoscaling": [],
    "tags": {}
  },
  "Dishes": {
