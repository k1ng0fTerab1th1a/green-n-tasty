  "DishSearch": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "token",
    "hash_key_type": "S",
    "sort_key_name": "dishId",
    "sort_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [],
